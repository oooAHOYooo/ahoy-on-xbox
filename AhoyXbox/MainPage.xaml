<Page x:Class="AhoyXbox.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#000000"
      XYFocusKeyboardNavigation="Enabled">

  <Grid Margin="36,24,36,20">
    <Grid.RowDefinitions>
      <!-- Top OSD Bar -->
      <RowDefinition Height="Auto"/>
      <!-- Main Video Canvas -->
      <RowDefinition Height="*"/>
      <!-- Lower-Third Subtle TV Guide -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top OSD: Minimal Network Watermark & Live Pip -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Brand Watermark -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/ahoy_official_white.png" Height="22" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.85"/>
        <TextBlock Text="tv" FontSize="14" FontWeight="Bold" Foreground="#FF0060" VerticalAlignment="Bottom" Margin="6,0,0,1"/>
      </StackPanel>

      <!-- Center Active Channel OSD -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderChannel" Text="CH 101 • LIVE SHOWS" FontSize="13" FontWeight="Bold" Foreground="#FF0060" Margin="0,0,12,0" CharacterSpacing="60"/>
        <TextBlock Text="•" FontSize="13" Foreground="#3A3A3C" Margin="0,0,12,0"/>
        <TextBlock x:Name="HeaderNowPlaying" Text="Connecting..." FontSize="13" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
      </StackPanel>

      <!-- Right Live Pip -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="6" Height="6" Fill="#FF0060" Margin="0,0,6,0"/>
        <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,16,0" CharacterSpacing="80"/>
        <TextBlock x:Name="SaveIndicator" Text="[X] SAVE" FontSize="11" FontWeight="SemiBold" Foreground="#636366"/>
      </StackPanel>
    </Grid>

    <!-- Main Video Stage: Cinematic Canvas -->
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Border Background="#000000" CornerRadius="10" BorderBrush="#1C1C1E" BorderThickness="1">
        <Grid>
          <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="True"/>

          <!-- Minimal Floating Stream Title Tag -->
          <Grid VerticalAlignment="Bottom" Background="#B3000000" Padding="18,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="NowPlaying" Text="Live Broadcast" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="Status" Text="Continuous independent stream · Next program queues automatically" FontSize="12" Foreground="#8E8E93" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Fullscreen [A]" Click="FullscreenClicked" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" Padding="12,5" CornerRadius="6" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Lower-Third Subtle TV Guide (Exactly 4 Canonical Channels) -->
    <Grid Grid.Row="2">
      <Border Background="#141418" BorderBrush="#24242A" BorderThickness="1" CornerRadius="12" Padding="14,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Guide Header Row -->
          <Grid Grid.Row="0" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="CHANNELS" FontSize="11" FontWeight="Bold" Foreground="#636366" CharacterSpacing="80"/>
            <TextBlock x:Name="GuideHeader" Grid.Column="1" Text="SCHEDULE • ON NOW &amp; UP NEXT" FontSize="11" FontWeight="Bold" Foreground="#636366" CharacterSpacing="80"/>
          </Grid>

          <!-- Split: 4 Channels on Left, Program Schedule on Right -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 4 Channels List -->
            <ListView x:Name="Channels" Grid.Column="0" Margin="0,0,14,0" SelectionChanged="ChannelChanged" IsItemClickEnabled="False">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,2" Padding="10,8" Background="#1C1C22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="Bold" Foreground="#FF0060" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding Tagline}" FontSize="10" Foreground="#8E8E93"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <!-- Programs Schedule on Active Channel -->
            <ListView x:Name="Programs" Grid.Column="1" MaxHeight="140" IsItemClickEnabled="True" ItemClick="PlayClicked" SelectionMode="Single">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,2" Padding="12,8" Background="#1C1C22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Host}" FontSize="11" Foreground="#8E8E93"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="ON AIR" FontSize="10" FontWeight="Bold" Foreground="#FF0060" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <!-- Subtle Controller Hints Line -->
          <Grid Grid.Row="2" Margin="6,8,6,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="▲/▼" FontSize="11" FontWeight="Bold" Foreground="#8E8E93"/>
              <TextBlock Text=" Surf Channels" FontSize="11" Foreground="#636366" Margin="0,0,16,0"/>
              <TextBlock Text="[A]" FontSize="11" FontWeight="Bold" Foreground="#8E8E93"/>
              <TextBlock Text=" Fullscreen" FontSize="11" Foreground="#636366" Margin="0,0,16,0"/>
              <TextBlock Text="[B]" FontSize="11" FontWeight="Bold" Foreground="#8E8E93"/>
              <TextBlock Text=" Guide" FontSize="11" Foreground="#636366" Margin="0,0,16,0"/>
              <TextBlock Text="[X]" FontSize="11" FontWeight="Bold" Foreground="#8E8E93"/>
              <TextBlock Text=" Save" FontSize="11" Foreground="#636366"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="AHOY INDIE MEDIA • 4 CHANNELS" FontSize="11" Foreground="#48484A" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>