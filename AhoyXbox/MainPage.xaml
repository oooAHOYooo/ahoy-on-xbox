<Page x:Class="AhoyXbox.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#06090F"
      XYFocusKeyboardNavigation="Enabled">

  <Grid Margin="32,18,32,18">
    <Grid.RowDefinitions>
      <!-- Top Liquid Glass Bar -->
      <RowDefinition Height="Auto"/>
      <!-- Main Content Stage (Player & 4-Channel EPG Guide) -->
      <RowDefinition Height="*"/>
      <!-- Bottom Controller Key Hints -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Liquid Glass Header Bar -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Liquid Brand Pill -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Padding="14,6" Background="#141E30" BorderBrush="#2A374D" BorderThickness="1" CornerRadius="20">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="ahoy" FontSize="26" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            <TextBlock Text="tv" FontSize="16" FontWeight="Bold" Foreground="#6DDCFF" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
          </StackPanel>
        </Border>
        <Border Margin="10,0,0,0" Padding="8,5" Background="#261016" BorderBrush="#4A1822" BorderThickness="1" CornerRadius="16" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="#FF3B30" Margin="0,0,6,0"/>
            <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Center 4-Channel Identity Banner -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Padding="14,6" Background="#0E1624" BorderBrush="#1E2A3E" BorderThickness="1" CornerRadius="20">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="HeaderChannel" Text="CH 101 • LIVE SHOWS" FontSize="14" FontWeight="Bold" Foreground="#6DDCFF" Margin="0,0,10,0"/>
            <TextBlock Text="|" FontSize="13" Foreground="#374151" Margin="0,0,10,0"/>
            <TextBlock x:Name="HeaderNowPlaying" Text="Connecting to live stream..." FontSize="14" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Right Meta & Save Pill -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Padding="12,6" Background="#0E1624" BorderBrush="#1E2A3E" BorderThickness="1" CornerRadius="20">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="4K HDR" FontSize="11" FontWeight="Bold" Foreground="#6DDCFF" Margin="0,0,12,0"/>
            <TextBlock x:Name="SaveIndicator" Text="[X] SAVE TO LIBRARY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Main Content Stage: Top Half Live Player, Bottom Half 4-Channel EPG Guide -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <!-- Top Half: Live Video Player (46%) -->
        <RowDefinition Height="46*"/>
        <!-- Bottom Half: Liquid Glass EPG Guide (54%) -->
        <RowDefinition Height="54*"/>
      </Grid.RowDefinitions>

      <!-- Player Viewport -->
      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Border Background="#000000" CornerRadius="14" BorderBrush="#1E2A3E" BorderThickness="1">
          <Grid>
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="True"/>

            <!-- Liquid Glass Stream Overlay -->
            <Grid VerticalAlignment="Bottom" Background="#D9080C14" Padding="20,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="NowPlaying" Text="Live Stream" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                  <Border Margin="10,0,0,0" Padding="6,2" Background="#132720" BorderBrush="#1E4D3A" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                    <TextBlock x:Name="LiveTag" Text="● ON AIR" FontSize="11" FontWeight="Bold" Foreground="#C7FF6B"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="Status" Text="Continuous 24/7 broadcast · Next program queues automatically" FontSize="13" Foreground="#94A3B8" Margin="0,3,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Fullscreen [A]" Click="FullscreenClicked" Background="#141E30" BorderBrush="#2A374D" BorderThickness="1" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Padding="14,6" CornerRadius="8" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Liquid Glass EPG Channel Guide (Exactly 4 Canonical Channels) -->
      <Grid Grid.Row="1">
        <Border Background="#0C121D" BorderBrush="#1E2A3E" BorderThickness="1" CornerRadius="14" Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <!-- Left Column: Exactly 4 Channels -->
              <ColumnDefinition Width="340"/>
              <!-- Right Column: Program Queue on this Channel -->
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Channels Column (4 Channels) -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="4 LIVE CHANNELS" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="4,0,0,8" CharacterSpacing="100"/>
              <ListView x:Name="Channels" Grid.Row="1" SelectionChanged="ChannelChanged" IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,3" Padding="12,10" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="38"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Number}" FontSize="15" FontWeight="Bold" Foreground="#6DDCFF" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Tagline}" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>

            <!-- Programs Schedule Column -->
            <Grid Grid.Column="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="4,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GuideHeader" Text="PROGRAM SCHEDULE • ON NOW &amp; UP NEXT" FontSize="12" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="100"/>
                <TextBlock Grid.Column="1" Text="Press A to watch specific show" FontSize="12" Foreground="#475569"/>
              </Grid>
              <ListView x:Name="Programs" Grid.Row="1" IsItemClickEnabled="True" ItemClick="PlayClicked" SelectionMode="Single">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,3" Padding="14,10" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Host}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#152338" BorderBrush="#253A5A" BorderThickness="1" Padding="8,4" CornerRadius="6" VerticalAlignment="Center" Margin="10,0,0,0">
                          <TextBlock Text="ON AIR" FontSize="11" FontWeight="Bold" Foreground="#C7FF6B"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Bottom Navigation & Controller Hints -->
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="D-PAD" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        <TextBlock Text=" Surf Channels" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock Text="[A]" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        <TextBlock Text=" Fullscreen / Select" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock Text="[B]" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        <TextBlock Text=" Guide / Back" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock Text="[X]" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        <TextBlock Text=" Bookmark / Save" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="AHOY INDIE MEDIA • 4 CHANNELS ALWAYS ON" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Page>