<Page x:Class="AhoyXbox.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#000000"
      XYFocusKeyboardNavigation="Enabled">

  <Grid Background="#000000">
    <!-- Full-bleed live stage, matching the Fire TV home composition. -->
    <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="True" Stretch="UniformToFill"/>
    <Rectangle Fill="#66000000" IsHitTestVisible="False">
      <Rectangle.Opacity>0.4</Rectangle.Opacity>
    </Rectangle>
    <Grid IsHitTestVisible="False" VerticalAlignment="Bottom" Height="560">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#00000000" Offset="0"/>
          <GradientStop Color="#B3000000" Offset="0.48"/>
          <GradientStop Color="#F5000000" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
    </Grid>

    <!-- Broadcast header with polished obsidian glass and simplified, balanced telemetry -->
    <Border x:Name="TopHeader" VerticalAlignment="Top" Height="74" Padding="52,0" Background="#E608090C" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="ms-appx:///Assets/ahoy_official_white.png" Height="26" Stretch="Uniform" VerticalAlignment="Center"/>
          <TextBlock Text="tv" FontSize="14" FontWeight="Black" Foreground="#FF0060" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="TabChannels" Content="LIVE TV" Click="TabChannels_Click" Background="#FF0060" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" CornerRadius="14" Padding="16,7" Margin="0,0,4,0"/>
          <Button x:Name="TabOnDemand" Content="ON DEMAND" Click="TabOnDemand_Click" Background="#14151A" BorderBrush="#24262E" BorderThickness="1" Foreground="#A0A0A8" FontWeight="Bold" FontSize="11" CornerRadius="14" Padding="16,7" Margin="0,0,4,0"/>
          <Button x:Name="TabMusic" Content="MUSIC" Click="TabMusic_Click" Background="#14151A" BorderBrush="#24262E" BorderThickness="1" Foreground="#A0A0A8" FontWeight="Bold" FontSize="11" CornerRadius="14" Padding="16,7" Margin="0,0,4,0"/>
          <Button x:Name="TabRadio" Content="RADIO" Click="TabRadio_Click" Background="#14151A" BorderBrush="#24262E" BorderThickness="1" Foreground="#A0A0A8" FontWeight="Bold" FontSize="11" CornerRadius="14" Padding="16,7"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="11,6" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="#FF0060" Margin="0,0,6,0"/>
              <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" CharacterSpacing="80"/>
            </StackPanel>
          </Border>
          <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="8,5,12,5" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="18" Height="18" CornerRadius="9" Background="#0078D7" Margin="0,0,6,0">
                <TextBlock Text="X" FontSize="10" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
              </Border>
              <TextBlock x:Name="SaveIndicator" Text="SAVE" FontSize="11" FontWeight="Bold" Foreground="#D0D0D8"/>
            </StackPanel>
          </Border>
          <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="8,5,12,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="18" Height="18" CornerRadius="9" Background="#FFB900" Margin="0,0,6,0">
                <TextBlock x:Name="AccountKeycapText" Text="Y" FontSize="10" FontWeight="Black" Foreground="#1A1500" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
              </Border>
              <TextBlock x:Name="AccountIndicator" Text="PAIR ID" FontSize="11" FontWeight="Bold" Foreground="#D0D0D8"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Program details sit directly over the live picture with Xbox safe margins -->
    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="52,0,0,260" MaxWidth="800" IsHitTestVisible="True">
      <TextBlock x:Name="HeaderChannel" Text="CH 101 · LIVE SHOWS" FontSize="13" FontWeight="Bold" Foreground="#FF4D90" CharacterSpacing="120"/>
      <TextBlock x:Name="NowPlaying" Text="Live Broadcast" FontSize="38" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="2" Margin="0,8,0,0"/>
      <TextBlock x:Name="HeaderNowPlaying" Text="Connecting..." FontSize="18" FontWeight="Bold" Foreground="#FF0060" TextTrimming="CharacterEllipsis" MaxWidth="720" Margin="0,4,0,0"/>
      <TextBlock x:Name="Status" Text="Continuous independent stream · Next program queues automatically" FontSize="14" Foreground="#DDFFFFFF" TextWrapping="Wrap" MaxWidth="650" MaxHeight="42" Margin="0,8,0,0"/>
      <Button Click="FullscreenClicked" Background="#FF0060" BorderBrush="#FF0060" Foreground="#FFFFFF" Padding="14,8,18,8" CornerRadius="8" HorizontalAlignment="Left" Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="18" Height="18" CornerRadius="9" Background="#107C10" Margin="0,0,8,0">
            <TextBlock Text="A" FontSize="10" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
          </Border>
          <TextBlock Text="FULLSCREEN" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Lower channel & media shelf with frosted obsidian glass and rich thumbnail cards -->
    <Border x:Name="GuideDock" VerticalAlignment="Bottom" Height="238" Padding="52,12,52,14" Background="#E608090C" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="26"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <TextBlock Text="CHANNELS · 4 CANONICAL PILLARS" FontSize="11" FontWeight="Bold" Foreground="#8E8E93" CharacterSpacing="120" VerticalAlignment="Center"/>
          <TextBlock x:Name="GuideHeader" Text="SCHEDULE • ON NOW &amp; UP NEXT" FontSize="11" FontWeight="Bold" Foreground="#FF0060" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <ListView x:Name="Channels" Grid.Row="1" SelectionChanged="ChannelChanged" IsItemClickEnabled="True" ItemClick="ChannelClicked" SelectionMode="Single"
                  Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Width" Value="252"/><Setter Property="Height" Value="154"/>
              <Setter Property="Margin" Value="0,4,16,4"/><Setter Property="Padding" Value="0"/>
              <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
              <Setter Property="FocusVisualPrimaryBrush" Value="#FF0060"/>
              <Setter Property="FocusVisualSecondaryBrush" Value="#FFFFFF"/>
              <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
              <Setter Property="FocusVisualMargin" Value="-3"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Border Background="#141418" BorderBrush="#2A2A34" BorderThickness="1" CornerRadius="16" Padding="14,10">
                <Grid>
                  <Image Source="{Binding Artwork}" Stretch="UniformToFill" Opacity="0.85"/>
                  <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00090A10" Offset="0.2"/>
                        <GradientStop Color="#F007080D" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <StackPanel VerticalAlignment="Bottom">
                    <Border Background="#33FF0060" BorderBrush="#66FF0060" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,4">
                      <TextBlock FontSize="9" FontWeight="Bold" Foreground="#FF0060" CharacterSpacing="80"><Run Text="CH "/><Run Text="{Binding Number}"/></TextBlock>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Tagline}" FontSize="11" Foreground="#A0A0A8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <ListView x:Name="Programs" Grid.Row="1" Visibility="Collapsed" MaxHeight="154" IsItemClickEnabled="True" ItemClick="PlayClicked" SelectionMode="Single"
                  Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Width" Value="252"/><Setter Property="Height" Value="154"/>
              <Setter Property="Margin" Value="0,4,16,4"/><Setter Property="Padding" Value="0"/>
              <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
              <Setter Property="FocusVisualPrimaryBrush" Value="#FF0060"/>
              <Setter Property="FocusVisualSecondaryBrush" Value="#FFFFFF"/>
              <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
              <Setter Property="FocusVisualMargin" Value="-3"/>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <Border Background="#141418" BorderBrush="#2A2A34" BorderThickness="1" CornerRadius="16" Padding="14,10">
                <Grid>
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Opacity="0.85"/>
                  <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00090A10" Offset="0.2"/>
                        <GradientStop Color="#F007080D" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <StackPanel VerticalAlignment="Bottom">
                    <Border Background="#33FF0060" BorderBrush="#66FF0060" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,4">
                      <TextBlock Text="{Binding DurationLabel}" FontSize="9" FontWeight="Bold" Foreground="#FF0060" CharacterSpacing="80"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Host}" FontSize="11" Foreground="#A0A0A8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="[D-PAD] Browse" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" Margin="0,0,18,0"/>
          <TextBlock Text="[A] Select / Tune" FontSize="10" FontWeight="Bold" Foreground="#3CD070" Margin="0,0,18,0"/>
          <TextBlock Text="[B] Guide" FontSize="10" FontWeight="Bold" Foreground="#FF5E6C" Margin="0,0,18,0"/>
          <TextBlock Text="[X] Save" FontSize="10" FontWeight="Bold" Foreground="#4BA3E3" Margin="0,0,18,0"/>
          <TextBlock Text="[Y] Account Pairing" FontSize="10" FontWeight="Bold" Foreground="#FFC83B" Margin="0,0,18,0"/>
          <TextBlock Text="[LT / RT] Switch Section" FontSize="10" FontWeight="Bold" Foreground="#B0B0B8"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Xbox account pairing remains a platform-specific overlay. -->
    <Grid x:Name="PairingOverlay" Background="#EE000000" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#141418" BorderBrush="#24242A" BorderThickness="1" CornerRadius="16" Padding="44,36" MaxWidth="560">
        <StackPanel HorizontalAlignment="Center">
          <Image Source="ms-appx:///Assets/ahoy_official_white.png" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <TextBlock Text="PAIR WITH AHOY ID" FontSize="11" FontWeight="Bold" Foreground="#FF0060" CharacterSpacing="120" HorizontalAlignment="Center" Margin="0,0,0,8"/>
          <TextBlock Text="Link your console to sync saved music, skate tapes &amp; culture across your screens." FontSize="14" Foreground="#8E8E93" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
          <Border Background="#000000" BorderBrush="#2C2C2E" BorderThickness="1" CornerRadius="10" Padding="28,14" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock x:Name="PairingCodeDisplay" Text="LOADING..." FontSize="34" FontWeight="Bold" Foreground="#FFFFFF" CharacterSpacing="120" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="1. Open id.ahoy.ooo/pair on your phone or computer" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <TextBlock Text="2. Enter the code above to connect your account" FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,0,0,24"/>
          <TextBlock x:Name="PairingStatusText" Text="Waiting for authorization..." FontSize="12" Foreground="#FF0060" HorizontalAlignment="Center" Margin="0,0,0,20"/>
          <Button Content="Dismiss [B]" Click="ClosePairingOverlay" Background="#1C1C22" BorderBrush="#2C2C2E" BorderThickness="1" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Padding="20,8" CornerRadius="6" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
