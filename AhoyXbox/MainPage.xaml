<Page x:Class="AhoyXbox.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#000000"
      XYFocusKeyboardNavigation="Enabled">

  <Grid Background="#000000">
    <!-- Full-bleed live stage, matching the Fire TV home composition. -->
    <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="True" Stretch="UniformToFill"/>
    <Rectangle Fill="#66000000" IsHitTestVisible="False">
      <Rectangle.Opacity>0.4</Rectangle.Opacity>
    </Rectangle>
    <Grid IsHitTestVisible="False" VerticalAlignment="Bottom" Height="560">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#00000000" Offset="0"/>
          <GradientStop Color="#B3000000" Offset="0.48"/>
          <GradientStop Color="#F5000000" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
    </Grid>

    <!-- Broadcast header -->
    <Grid VerticalAlignment="Top" Height="76" Margin="42,0" Background="#99000000">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/ahoy_official_white.png" Height="24" Stretch="Uniform" VerticalAlignment="Center"/>
        <TextBlock Text="tv" FontSize="14" FontWeight="Bold" Foreground="#FF0060" VerticalAlignment="Bottom" Margin="6,0,0,1"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="TabChannels" Content="LIVE TV" Click="TabChannels_Click" Background="#FF0060" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" CornerRadius="6" Padding="14,8" Margin="0,0,5,0"/>
        <Button x:Name="TabOnDemand" Content="ON DEMAND" Click="TabOnDemand_Click" Background="#1C1C22" Foreground="#96969D" FontWeight="SemiBold" FontSize="11" CornerRadius="6" Padding="14,8" Margin="0,0,5,0"/>
        <Button x:Name="TabMusic" Content="MUSIC" Click="TabMusic_Click" Background="#1C1C22" Foreground="#96969D" FontWeight="SemiBold" FontSize="11" CornerRadius="6" Padding="14,8" Margin="0,0,5,0"/>
        <Button x:Name="TabPodcasts" Content="PODCASTS" Click="TabPodcasts_Click" Background="#1C1C22" Foreground="#96969D" FontWeight="SemiBold" FontSize="11" CornerRadius="6" Padding="14,8"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="7" Height="7" Fill="#FF0060" Margin="0,0,7,0"/>
        <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,16,0" CharacterSpacing="80"/>
        <TextBlock x:Name="SaveIndicator" Text="[X] SAVE" FontSize="11" FontWeight="SemiBold" Foreground="#96969D" Margin="0,0,14,0"/>
        <TextBlock x:Name="AccountIndicator" Text="[Y] PAIR ID" FontSize="11" FontWeight="SemiBold" Foreground="#FF0060"/>
      </StackPanel>
    </Grid>

    <!-- Program details sit directly over the live picture. -->
    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="48,0,0,260" MaxWidth="800" IsHitTestVisible="True">
      <TextBlock x:Name="HeaderChannel" Text="CH 101 · LIVE SHOWS" FontSize="12" FontWeight="Bold" Foreground="#FF4D90" CharacterSpacing="120"/>
      <TextBlock x:Name="NowPlaying" Text="Live Broadcast" FontSize="38" FontWeight="Black" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="2" Margin="0,8,0,0"/>
      <TextBlock x:Name="HeaderNowPlaying" Text="Connecting..." FontSize="17" FontWeight="Bold" Foreground="#FF0060" TextTrimming="CharacterEllipsis" MaxWidth="720" Margin="0,4,0,0"/>
      <TextBlock x:Name="Status" Text="Continuous independent stream · Next program queues automatically" FontSize="14" Foreground="#DDFFFFFF" TextWrapping="Wrap" MaxWidth="650" MaxHeight="42" Margin="0,8,0,0"/>
      <Button Content="Fullscreen  [A]" Click="FullscreenClicked" Background="#FF0060" BorderBrush="#FF0060" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Padding="18,9" CornerRadius="6" HorizontalAlignment="Left" Margin="0,14,0,0"/>
    </StackPanel>

    <!-- Fire TV style lower channel shelf; program list remains available in other sections. -->
    <Border x:Name="GuideDock" VerticalAlignment="Bottom" Height="224" Background="#D9000000" Padding="42,10,42,12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="24"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="22"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <TextBlock Text="CHANNELS · 4 CANONICAL PILLARS" FontSize="10" FontWeight="Bold" Foreground="#8E8E93" CharacterSpacing="100" VerticalAlignment="Center"/>
        <TextBlock x:Name="GuideHeader" Text="SCHEDULE • ON NOW &amp; UP NEXT" FontSize="10" FontWeight="Bold" Foreground="#FF0060" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <ListView x:Name="Channels" Grid.Row="1" SelectionChanged="ChannelChanged" IsItemClickEnabled="True" ItemClick="ChannelClicked" SelectionMode="Single"
                Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="Width" Value="250"/><Setter Property="Height" Value="154"/>
            <Setter Property="Margin" Value="0,4,16,4"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Background="#1C1C22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="18" Padding="14,10">
              <Grid>
                <Image Source="{Binding Artwork}" Stretch="UniformToFill" Opacity="0.82"/>
                <Rectangle IsHitTestVisible="False">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#00111118" Offset="0.25"/>
                      <GradientStop Color="#EE0B0D16" Offset="1"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FF4D90" CharacterSpacing="100"><Run Text="CH "/><Run Text="{Binding Number}"/></TextBlock>
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding Tagline}" FontSize="11" Foreground="#B5B5BB" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <ListView x:Name="Programs" Grid.Row="1" Visibility="Collapsed" MaxHeight="154" IsItemClickEnabled="True" ItemClick="PlayClicked" SelectionMode="Single"
                Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Width" Value="250"/><Setter Property="Height" Value="154"/><Setter Property="Margin" Value="0,4,16,4"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Background="#1C1C22" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="18" Padding="14,10">
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock Text="{Binding DurationLabel}" FontSize="10" FontWeight="Bold" Foreground="#FF4D90"/>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Host}" FontSize="11" Foreground="#B5B5BB" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock Grid.Row="2" Text="D-pad Browse     A Select     B Guide     X Save     Y Pair ID" FontSize="10" Foreground="#77777D" VerticalAlignment="Center"/>
    </Grid>
    </Border>

    <!-- Xbox account pairing remains a platform-specific overlay. -->
    <Grid x:Name="PairingOverlay" Background="#EE000000" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#141418" BorderBrush="#24242A" BorderThickness="1" CornerRadius="16" Padding="44,36" MaxWidth="560">
        <StackPanel HorizontalAlignment="Center">
          <Image Source="ms-appx:///Assets/ahoy_official_white.png" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <TextBlock Text="PAIR WITH AHOY ID" FontSize="11" FontWeight="Bold" Foreground="#FF0060" CharacterSpacing="120" HorizontalAlignment="Center" Margin="0,0,0,8"/>
          <TextBlock Text="Link your console to sync saved music, skate tapes &amp; culture across your screens." FontSize="14" Foreground="#8E8E93" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
          <Border Background="#000000" BorderBrush="#2C2C2E" BorderThickness="1" CornerRadius="10" Padding="28,14" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock x:Name="PairingCodeDisplay" Text="LOADING..." FontSize="34" FontWeight="Bold" Foreground="#FFFFFF" CharacterSpacing="120" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="1. Open id.ahoy.ooo/pair on your phone or computer" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <TextBlock Text="2. Enter the code above to connect your account" FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,0,0,24"/>
          <TextBlock x:Name="PairingStatusText" Text="Waiting for authorization..." FontSize="12" Foreground="#FF0060" HorizontalAlignment="Center" Margin="0,0,0,20"/>
          <Button Content="Dismiss [B]" Click="ClosePairingOverlay" Background="#1C1C22" BorderBrush="#2C2C2E" BorderThickness="1" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Padding="20,8" CornerRadius="6" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
