<Page x:Class="AhoyXbox.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#070A10"
      XYFocusKeyboardNavigation="Enabled">

  <Grid Margin="36,20,36,20">
    <Grid.RowDefinitions>
      <!-- Top Brand & Status Bar -->
      <RowDefinition Height="Auto"/>
      <!-- Main Content Stage (Player & Live Guide) -->
      <RowDefinition Height="*"/>
      <!-- Bottom Controller Key Hints -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Brand & Live Airplay Bar -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Brand -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="ahoy" FontSize="36" FontWeight="Black" Foreground="#C7FF6B" VerticalAlignment="Center"/>
        <TextBlock Text="tv" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
        <Border Margin="18,0,0,0" Padding="8,3" Background="#1F2937" CornerRadius="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="#FF3B30" Margin="0,0,6,0"/>
            <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Current Airplay Channel Banner -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderChannel" Text="CH 101 • AHOY TV LIVE" FontSize="15" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,12,0"/>
        <TextBlock Text="|" FontSize="14" Foreground="#374151" Margin="0,0,12,0"/>
        <TextBlock x:Name="HeaderNowPlaying" Text="Connecting to live broadcast..." FontSize="15" Foreground="#E5E7EB"/>
      </StackPanel>

      <!-- Right Mode Badge -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Padding="10,4" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="4">
          <TextBlock x:Name="SaveIndicator" Text="[X] SAVE TO LIBRARY" FontSize="12" FontWeight="Bold" Foreground="#9CA3AF"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Main Content Stage -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <!-- Top Half: Live Video Player Viewport -->
        <RowDefinition Height="46*"/>
        <!-- Bottom Half: Pluto-Style Live EPG Guide -->
        <RowDefinition Height="54*"/>
      </Grid.RowDefinitions>

      <!-- Top Half Player Stage -->
      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Border Background="#000000" CornerRadius="8" BorderBrush="#1F2937" BorderThickness="1">
          <Grid>
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="True"/>
            
            <!-- Player Bottom Gradient Overlay with Stream Info -->
            <Grid VerticalAlignment="Bottom" Background="#CC070A10" Padding="20,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="NowPlaying" Text="Live Stream" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="LiveTag" Text=" ● ON AIR" FontSize="13" FontWeight="Bold" Foreground="#C7FF6B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="Status" Text="Continuous independent broadcast · Next program queues automatically" FontSize="13" Foreground="#9CA3AF" Margin="0,2,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Fullscreen [A]" Click="FullscreenClicked" Background="#1F2937" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Padding="12,6" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Bottom Half: Pluto-Style Live EPG Guide Grid -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <!-- Left Column: Channel Lineup -->
          <ColumnDefinition Width="340"/>
          <!-- Right Column: Programs on this Channel -->
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Channels Column -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="LIVE CHANNELS" FontSize="13" FontWeight="Bold" Foreground="#6B7280" Margin="4,0,0,8"/>
          <ListView x:Name="Channels" Grid.Row="1" SelectionChanged="ChannelChanged" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,2" Padding="12,8" Background="#0F1420" CornerRadius="6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Tagline}" FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>

        <!-- Programs Column (EPG Lineup) -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="4,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="GuideHeader" Text="PROGRAM SCHEDULE • ON NOW &amp; UP NEXT" FontSize="13" FontWeight="Bold" Foreground="#6B7280"/>
            <TextBlock Grid.Column="1" Text="Press A to watch specific show" FontSize="12" Foreground="#4B5563"/>
          </Grid>
          <ListView x:Name="Programs" Grid.Row="1" IsItemClickEnabled="True" ItemClick="PlayClicked" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,2" Padding="14,10" Background="#0F1420" CornerRadius="6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Host}" FontSize="13" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#1E2638" Padding="8,4" CornerRadius="4" VerticalAlignment="Center" Margin="10,0,0,0">
                      <TextBlock Text="ON AIR" FontSize="11" FontWeight="Bold" Foreground="#C7FF6B"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Grid>
    </Grid>

    <!-- Bottom Navigation Bar & Controller Hints -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="D-PAD" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        <TextBlock Text=" Surf Channels" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock Text="[A]" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        <TextBlock Text=" Select / Fullscreen" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock Text="[B]" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        <TextBlock Text=" Guide / Back" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock Text="[X]" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
        <TextBlock Text=" Bookmark / Save" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="AHOY INDIE MEDIA • ALWAYS ON" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Page>